# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file with credentials.

# Port the server will listen on
PORT=5000

# MongoDB Atlas connection string.
# In Atlas: Database -> Connect -> Drivers -> Node.js -> copy the URI.
# Replace <username> and <password> with your Atlas database user.
# Example:
# mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Database name used inside the cluster
DB_NAME=college_events
